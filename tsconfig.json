{
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": true,
    "module": "es6",
    "target": "es6",
    "lib": ["es2020", "dom", "dom.iterable"],
    "allowJs": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "rootDir": "./src",
    "outDir": "./dist/"
  },
  "include": ["src"]
}
