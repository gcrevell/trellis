{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    // custom-card-helpers' .d.ts files import lit, which isn't installed. That
    // doesn't affect the emitted output, and the build must not fail on it.
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
